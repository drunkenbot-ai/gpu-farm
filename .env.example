# FARM_MODE=local -- private farm, no license/subscription checks.
# FARM_MODE=cloud -- shared farm, gated by drunkenbot-ai/cloud-service entitlement.
FARM_MODE=local

HOST=0.0.0.0
PORT=8080

DATABASE_URL=sqlite:///./farm_manager.db
ARTIFACT_ROOT=./artifacts

# Only used when FARM_MODE=cloud.
CLOUD_SERVICE_URL=https://cloud.drunkenbot.ai
CLOUD_SERVICE_TIMEOUT_SECONDS=15
# Endpoint to atomically debit a completed job's GPU-hours in cloud-service.
CLOUD_USAGE_REPORT_PATH=/auth/report-usage

# Comma-separated browser origins allowed to call the API cross-origin.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional. When set, job submission and lifecycle mutation endpoints require
# this value in X-Farm-Admin-Token.
FARM_ADMIN_TOKEN=

STALE_WORKER_TIMEOUT_SECONDS=30
